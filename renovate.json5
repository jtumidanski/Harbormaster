{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // The forge-local preset already carries config:recommended and the
  // dependency dashboard, and disables the github-actions manager (action
  // pins are mirrored into the forge by hand, so they move by hand).
  // go-toolchain opts in to go directive bumps (it overrides the pin below for
  // the directive, which pin would otherwise never move).
  extends: ["local>renovate/presets", "local>renovate/presets:go-toolchain", ":semanticCommits"],
  rangeStrategy: "pin",
  customManagers: [
    {
      customType: "regex",
      description: "tools/toolchain.versions GO_VERSION: verify.sh exports GOTOOLCHAIN=go${GO_VERSION}, so it must move with go.mod, which CI reads via go-version-file.",
      managerFilePatterns: ["/^tools/toolchain\\.versions$/"],
      matchStrings: ["(?:^|\\n)GO_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      datasourceTemplate: "golang-version",
      depNameTemplate: "go",
      versioningTemplate: "semver",
    },
  ],
  packageRules: [
    {
      matchManagers: ["gomod"],
      groupName: "go modules",
      minimumReleaseAge: "3 days",
    },
    {
      matchManagers: ["npm"],
      groupName: "npm dependencies",
      minimumReleaseAge: "3 days",
    },
    {
      matchManagers: ["dockerfile"],
      groupName: "docker base images",
      minimumReleaseAge: "7 days",
    },
    {
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "7 days",
    },
    {
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    // Never auto-merge runtime / security / auth libs even on patch
    {
      matchPackageNames: [
        "golang.org/x/crypto",
        "github.com/minio/minio-go/v7",
        "github.com/minio/madmin-go/v3",
        "github.com/go-chi/chi/v5",
        "gorm.io/gorm",
        "github.com/glebarez/sqlite",
        "github.com/golang-migrate/migrate/v4",
        "github.com/spf13/viper",
        "react",
        "react-dom",
        "@tanstack/react-query",
      ],
      automerge: false,
    },
    // Last so it overrides the "go modules" and "docker base images" groups:
    // go.mod directive, toolchain.versions and the golang builder image move
    // as one PR.
    {
      matchDatasources: ["golang-version", "docker"],
      matchPackageNames: ["go", "golang"],
      groupName: "Go toolchain",
      automerge: false,
    },
  ],
  vulnerabilityAlerts: {
    labels: ["security"],
    minimumReleaseAge: "0",
  },
}
